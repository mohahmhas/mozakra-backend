{
  "compilerOptions": {
    /* =========================
     * Project Structure
     * ========================= */
    "rootDir": "./src",
    "outDir": "./dist",

    /* =========================
     * Language & Modules
     * ========================= */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* =========================
     * Type Checking
     * ========================= */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* =========================
     * Imports
     * ========================= */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* =========================
     * Output
     * ========================= */
    "sourceMap": true,

    /* =========================
     * Performance
     * ========================= */
    "skipLibCheck": true,

    /* =========================
     * Node Types
     * ========================= */
    "types": ["node"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}